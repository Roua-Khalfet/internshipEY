# Example .env for local development
# Copy to `.env` and replace placeholders with real secrets.

# LLM Provider selection: 'nvidia', 'gemini', or 'groq'
LLM_PROVIDER=nvidia

# NVIDIA NIM / OpenAI-compatible endpoint
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SOC_LLM_MODEL=google/diffusiongemma-26b-a4b-it

# Gemini API key (fallback / alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (fallback / alternative)
# GROQ_API_KEY=your_groq_api_key_here

# Notes:
# - Do NOT commit your .env file containing real secrets.
# - For CI / production, use a secret manager instead of .env.

