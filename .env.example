# Example .env for local development
# Copy to `.env` and replace placeholders with real secrets.

# Gemini API key (set this to your real key)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the LLM model name
SOC_LLM_MODEL=gemini-2.0-flash

# Notes:
# - Do NOT commit your .env file containing real secrets.
# - For CI / production, use a secret manager instead of .env.
